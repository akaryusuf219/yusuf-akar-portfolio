<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#1a1040;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#07080f;stop-opacity:1" />
    </radialGradient>
    <radialGradient id="avatarGrad" cx="50%" cy="35%" r="60%">
      <stop offset="0%" style="stop-color:#a78bfa;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6c63ff;stop-opacity:1" />
    </radialGradient>
    <radialGradient id="glowGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#6c63ff;stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:#6c63ff;stop-opacity:0" />
    </radialGradient>
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c6ff7" />
      <stop offset="100%" style="stop-color:#4c46c8" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <clipPath id="circle">
      <circle cx="200" cy="200" r="200"/>
    </clipPath>
  </defs>

  <!-- Background -->
  <circle cx="200" cy="200" r="200" fill="url(#bgGrad)"/>

  <!-- Glow ring -->
  <circle cx="200" cy="200" r="180" fill="none" stroke="url(#glowGrad)" stroke-width="2" opacity="0.6"/>

  <!-- Circuit lines decorative -->
  <g opacity="0.15" stroke="#6c63ff" stroke-width="1" fill="none">
    <line x1="50"  y1="100" x2="120" y2="100"/>
    <line x1="120" y1="100" x2="120" y2="70"/>
    <circle cx="120" cy="70" r="3" fill="#6c63ff"/>
    <line x1="280" y1="100" x2="350" y2="100"/>
    <line x1="280" y1="100" x2="280" y2="70"/>
    <circle cx="280" cy="70" r="3" fill="#6c63ff"/>
    <line x1="60"  y1="300" x2="60"  y2="330"/>
    <line x1="60"  y1="330" x2="100" y2="330"/>
    <circle cx="100" cy="330" r="3" fill="#6c63ff"/>
    <line x1="340" y1="300" x2="340" y2="330"/>
    <line x1="300" y1="330" x2="340" y2="330"/>
    <circle cx="300" cy="330" r="3" fill="#6c63ff"/>
    <line x1="30"  y1="200" x2="70"  y2="200"/>
    <line x1="330" y1="200" x2="370" y2="200"/>
  </g>

  <!-- Body / Shirt -->
  <ellipse cx="200" cy="340" rx="110" ry="80" fill="url(#bodyGrad)" clip-path="url(#circle)"/>
  <!-- Collar -->
  <polygon points="180,270 200,295 220,270 210,260 200,275 190,260" fill="#f0f2ff" opacity="0.9"/>

  <!-- Neck -->
  <rect x="185" y="235" width="30" height="40" rx="8" fill="#c4a882"/>

  <!-- Head -->
  <ellipse cx="200" cy="195" rx="70" ry="80" fill="#d4a574"/>

  <!-- Hair -->
  <ellipse cx="200" cy="140" rx="72" ry="45" fill="#1a1010"/>
  <ellipse cx="200" cy="128" rx="60" ry="30" fill="#2a1a1a"/>
  <!-- Side hair -->
  <ellipse cx="135" cy="175" rx="15" ry="35" fill="#1a1010"/>
  <ellipse cx="265" cy="175" rx="15" ry="35" fill="#1a1010"/>

  <!-- Ears -->
  <ellipse cx="132" cy="200" rx="12" ry="16" fill="#c4976a"/>
  <ellipse cx="268" cy="200" rx="12" ry="16" fill="#c4976a"/>

  <!-- Eyes -->
  <ellipse cx="175" cy="195" rx="13" ry="14" fill="white"/>
  <ellipse cx="225" cy="195" rx="13" ry="14" fill="white"/>
  <!-- Irises -->
  <circle cx="177" cy="197" r="8" fill="#2a1a3a"/>
  <circle cx="227" cy="197" r="8" fill="#2a1a3a"/>
  <!-- Pupils -->
  <circle cx="178" cy="198" r="4" fill="#0a0a14"/>
  <circle cx="228" cy="198" r="4" fill="#0a0a14"/>
  <!-- Eye shine -->
  <circle cx="180" cy="195" r="2" fill="white" opacity="0.8"/>
  <circle cx="230" cy="195" r="2" fill="white" opacity="0.8"/>

  <!-- Eyebrows -->
  <path d="M163 181 Q176 175 189 180" stroke="#1a0a0a" stroke-width="3" fill="none" stroke-linecap="round"/>
  <path d="M211 180 Q224 175 237 181" stroke="#1a0a0a" stroke-width="3" fill="none" stroke-linecap="round"/>

  <!-- Nose -->
  <path d="M196 210 Q193 225 200 228 Q207 225 204 210" stroke="#b08060" stroke-width="1.5" fill="none" stroke-linecap="round"/>

  <!-- Smile -->
  <path d="M182 240 Q200 254 218 240" stroke="#8b5e3c" stroke-width="2.5" fill="none" stroke-linecap="round"/>

  <!-- YA initials badge -->
  <circle cx="310" cy="310" r="35" fill="#6c63ff" opacity="0.95" filter="url(#glow)"/>
  <text x="310" y="320" font-family="Outfit,Arial,sans-serif" font-size="18" font-weight="900" fill="white" text-anchor="middle">YA</text>

  <!-- Stars/dots decoration -->
  <circle cx="80"  cy="80"  r="2" fill="#a78bfa" opacity="0.7"/>
  <circle cx="320" cy="80"  r="2" fill="#a78bfa" opacity="0.7"/>
  <circle cx="60"  cy="260" r="1.5" fill="#38bdf8" opacity="0.6"/>
  <circle cx="340" cy="260" r="1.5" fill="#38bdf8" opacity="0.6"/>
  <circle cx="100" cy="350" r="1.5" fill="#6c63ff" opacity="0.5"/>
  <circle cx="300" cy="350" r="1.5" fill="#6c63ff" opacity="0.5"/>
</svg>
